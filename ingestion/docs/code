##visualization 1

{r}
# Create the bar chart
ggplot(top_major_wage,
       aes(x = reorder(Major, median_wage),
           y = median_wage,
           fill = Major)) +
  geom_col() +
  coord_flip() +
  scale_y_continuous(labels = scales::dollar) +
  labs(
    title = "College Majors with the Highest Median Wages",
    x = "College Major",
    y = "Median Annual Wage ($)",
    fill = "College Major",
    caption = "Source: 2024 ACS PUMS"
  ) +
  theme_minimal() +
  theme(
    legend.position = "right",
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank()
  )

