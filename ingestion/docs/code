{r}
# Calculate median wage by major and sex
major_sex_wage <- jobs1 |>
  
  # Keep the top 8 majors
  filter(FOD1P %in% top_major_wage$FOD1P) |>
  
  # Convert codes into names
  mutate(
    Major = case_when(
      FOD1P == 2408 ~ "Electrical Engineering",
      FOD1P == 2417 ~ "Naval Architecture and Marine Engineering",
      FOD1P == 3702 ~ "Statistics and Decision Science",
      FOD1P == 2401 ~ "Aerospace Engineering",
      FOD1P == 2102 ~ "Computer Science",
      FOD1P == 2407 ~ "Computer Engineering",
      FOD1P == 6204 ~ "Operations, Logistics and E-Commerce",
      FOD1P == 6212 ~ "Management Information Systems and Statistics"
    ),
    
    # Convert sex codes into names
    Sex = case_when(
      SEX == 1 ~ "Male",
      SEX == 2 ~ "Female"
    )
  ) |>
  
  # Group the data
  group_by(Major, Sex) |>
  
  # Calculate median wage
  summarise(
    median_wage = median(WAGP))

{r}


# Create the grouped bar chart
ggplot(
  major_sex_wage,
  aes(
    x = factor(Major, levels = major_order),
    y = median_wage,
    fill = Sex
  )
) +
  geom_col(position = "dodge") +
  coord_flip() +
  scale_y_continuous(labels = scales::dollar) +
  scale_fill_manual(
    values = c(
      "Male" = "lightblue",
      "Female" = "pink"
    )
  ) +
  labs(
    title = "Median Wages by College Major and Sex",
    x = "College Major",
    y = "Median Annual Wage ($)",
    fill = "Sex",
    caption = "Source: 2024 ACS PUMS"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(hjust = 0.5),
    legend.position = "right"
  )

{r}
#visualization 3 
#How does median wage vary across age groups for male and female college graduates in Maryland?

# Calculate median wage by age group and sex
age_sex_wage <- jobs1 |>
  
  # Keep people age 20 and older
  filter(AGEP >= 20) |>
  
  # Create age groups and sex labels
  mutate(
    Age_Group = cut(
      AGEP,
      breaks = c(19, 29, 39, 49, 59, 69, Inf),
      labels = c("20–29", "30–39", "40–49",
                 "50–59", "60–69", "70+")
    ),
    Sex = case_when(
      SEX == 1 ~ "Male",
      SEX == 2 ~ "Female"
    )
  ) |>
  
  # Group by age and sex
  group_by(Age_Group, Sex) |>
  
  # Calculate median wage
  summarise(
    median_wage = median(WAGP),
    .groups = "drop"
  )


{r}
# Create the line chart
ggplot(
  age_sex_wage,
  aes(
    x = Age_Group,
    y = median_wage,
    color = Sex,
    group = Sex
  )
) +
  geom_line(linewidth = 1) +
  geom_point(size = 3) +
  scale_y_continuous(labels = scales::dollar) +
  scale_color_manual(
    values = c(
      "Male" = "lightblue",
      "Female" = "pink"
    )
  ) +
  labs(
    title = "Median Wage by Age Group and Sex",
    x = "Age Group",
    y = "Median Annual Wage ($)",
    color = "Sex",
    caption = "Source: 2024 ACS PUMS"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(hjust = 0.5),
    legend.position = "right"
  )

