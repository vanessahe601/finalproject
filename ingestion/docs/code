{r}
library(tidyverse)

# Read the dataset
p1 <- read_csv("md.csv")

# View the dataset
View(p1)

# Keep college graduates with valid wages and majors
jobs1 <- p1 |>
  filter(
    !is.na(WAGP),
    !is.na(FOD1P),
    !is.na(SCHL),
    !is.na(SEX),
    SCHL == 21,
    WAGP > 0)

# Calculate median wage for each major
major_wage <- jobs1 |>
  group_by(FOD1P) |>
  summarise(
    median_wage = median(WAGP),# Calculate median wage
    sample_size = n()) |>  # Count people in each major
     
  filter(sample_size >= 10) |> # Remove very small groups
  arrange(desc(median_wage))  # Rank wages from high to low


# View the result
View(major_wage)

#2408 electrical engineering ,2417 naval architecture and marine engineering,
#3702 statistics and decision science, 2401 aerospace engineering ,
#2102 computer science ,2407 computer engineering,6204 operations logistics and E-commerce
#6212 management information systems and statistics



top_major_wage <- major_wage |>
  head(8) |>
  mutate(Major = case_when(
    FOD1P == 2408 ~ "Electrical Engineering",
    FOD1P == 2417 ~ "Naval Architecture and Marine Engineering",
    FOD1P == 3702 ~ "Statistics and Decision Science",
    FOD1P == 2401 ~ "Aerospace Engineering",
    FOD1P == 2102 ~ "Computer Science",
    FOD1P == 2407 ~ "Computer Engineering",
    FOD1P == 6204 ~ "Operations, Logistics and E-Commerce",
